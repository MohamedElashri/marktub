{
  "name": "marktub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/licenses.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint src tests scripts benchmarks vite.config.ts",
    "test": "vitest run",
    "test:tooling": "node --test tests/tooling/*.test.mjs && python3 -m unittest discover -s tests/tooling -p 'test_*.py'",
    "test:e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tooling && pnpm format:check",
    "fixtures": "node scripts/fixtures.mjs",
    "bench:open": "node scripts/range-bench.mjs",
    "bench:dom": "vitest run --config benchmarks/vitest.config.ts",
    "bench:baseline": "node scripts/build-baseline.mjs",
    "bench:memory": "python3 benchmarks/process_tree.py",
    "bench:startup": "python3 benchmarks/startup.py",
    "check:release": "node scripts/check-release.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "source:archive": "python3 scripts/source-archive.py"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "12.3.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@wdio/cli": "9.33.1",
    "@wdio/globals": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "expect-webdriverio": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "webdriverio": "9.33.1"
  }
}
